# Saltos de línea consistentes entre Windows y Mac.
* text=auto eol=lf

# Scripts de Windows: siempre con saltos de línea de Windows.
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Scripts de Mac/Linux: siempre con saltos de línea de Unix.
*.sh text eol=lf
*.command text eol=lf

# Binarios
*.ico binary
*.png binary
*.jpg binary
